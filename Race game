<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no"><title>Tap Race</title><style>*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui}body{background:#0a0a0a;color:#fff;display:flex;justify-content:center;align-items:center;min-height:100vh}.card{width:96%;max-width:380px;background:#1c1c1e;border-radius:22px;padding:20px;text-align:center;border:2px solid #ffcc00}h1{font-size:28px;margin-bottom:5px}#timer{font-size:60px;font-weight:900;color:#ffcc00}#taps{font-size:78px;font-weight:900}#tapBtn{width:100%;height:200px;border-radius:20px;border:0;background:linear-gradient(#ffcc00,#ff8800);font-size:32px;font-weight:900;color:#111;margin:15px 0}#tapBtn:active{transform:scale(.96)}.stats{display:flex;justify-content:space-around;margin:10px 0}.stat{background:#2c2c2e;padding:10px 16px;border-radius:12px;min-width:90px}.stat b{display:block;font-size:20px;color:#ffcc00}.btn{padding:14px 22px;border-radius:22px;border:0;font-weight:800;background:#fff;color:#000;margin-top:10px;width:100%}</style></head><body><div class="card"><h1>👆 TAP RACE</h1><p>How fast can you tap in 10 sec?</p><div id="timer">10.0</div><div id="taps">0</div><button id="tapBtn">TAP ME!!!</button><div class="stats"><div class="stat">Best<b id="best">0</b></div><div class="stat">Speed<b id="speed">0.0</b>/s</div></div><button class="btn" onclick="startGame()">PLAY AGAIN</button></div><script>let taps=0,time=10,running=false,interval,best=localStorage.getItem('tapBest')||0;document.getElementById('best').textContent=best;const tapsEl=document.getElementById('taps'),timerEl=document.getElementById('timer'),speedEl=document.getElementById('speed'),btn=document.getElementById('tapBtn');function startGame(){taps=0;time=10;running=false;tapsEl.textContent=0;timerEl.textContent='10.0';btn.textContent='TAP ME!!!';btn.disabled=false;speedEl.textContent='0.0';clearInterval(interval)}btn.addEventListener('touchstart',e=>{e.preventDefault();doTap()},{passive:false});btn.addEventListener('mousedown',doTap);function doTap(){if(time<=0)return;if(!running){running=true;startTimer()}taps++;tapsEl.textContent=taps;if(navigator.vibrate)navigator.vibrate(10);speedEl.textContent=(taps/(10.1-time||0.1)).toFixed(1)}function startTimer(){interval=setInterval(()=>{time-=0.1;if(time<0)time=0;timerEl.textContent=time.toFixed(1);if(time<=0){clearInterval(interval);endGame()}},100)}function endGame(){btn.disabled=true;btn.textContent='TIME UP!';if(taps>best){best=taps;localStorage.setItem('tapBest',best);document.getElementById('best').textContent=best}alert('SCORE: '+taps+' taps!\nBest: '+best)}startGame();</script></body></html>
